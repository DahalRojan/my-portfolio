---
import { getLangFromUrl, useTranslations, localePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = [
  { href: localePath('/writing', lang), label: t('nav.writing') },
  { href: localePath('/work', lang), label: t('nav.work') },
  { href: localePath('/about', lang), label: t('nav.about') },
  { href: localePath('/search', lang), label: t('nav.search') },
];

const elsewhere = [
  { href: lang === 'ne' ? '/ne/rss.xml' : '/rss.xml', label: t('footer.rss') },
  { href: 'https://www.linkedin.com/in/rojandahal/', label: t('footer.linkedin'), external: true },
  { href: 'https://github.com/DahalRojan', label: t('footer.github'), external: true },
  { href: 'mailto:rojandahal1026@gmail.com', label: t('footer.email') },
  { href: '/Resume_Rojan_Dahal.pdf', label: t('footer.resume') },
];
---

<footer class="mt-32 border-t border-[var(--color-rule)]">
  <div class="container-x py-14">
    <div class="grid gap-10 sm:grid-cols-[1.5fr_1fr_1fr]">
      <div class="measure">
        <p class="display text-[1.5rem] leading-tight">Rojan Dahal</p>
        <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
          {t('footer.blurb')}
        </p>
      </div>

      <nav aria-label={t('footer.nav.aria')}>
        <h2 class="label">{t('footer.heading.site')}</h2>
        <ul class="mt-4 space-y-2 text-[15px] text-[var(--color-ink-soft)]">
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={href} class="link-grow hover:text-[var(--color-ink)]">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t('footer.elsewhere.aria')}>
        <h2 class="label">{t('footer.heading.elsewhere')}</h2>
        <ul class="mt-4 space-y-2 text-[15px] text-[var(--color-ink-soft)]">
          {
            elsewhere.map(({ href, label, external }) => (
              <li>
                <a
                  href={href}
                  class="link-grow hover:text-[var(--color-ink)]"
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-[var(--color-rule)] pt-6 text-[13px] text-[var(--color-ink-faint)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {year} Rojan Dahal. {t('footer.builtIn.before')}<span class="display-italic"
          >{t('footer.builtIn.place')}</span
        >{t('footer.builtIn.after')}
      </p>
      <p class="mono">{t('footer.colophon')}</p>
    </div>
  </div>
</footer>
