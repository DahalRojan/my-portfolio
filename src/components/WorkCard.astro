---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  href: string;
  title: string;
  role: string;
  period: string;
  summary: string;
  stack?: string[];
}

const { href, title, role, period, summary, stack = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article class="work-card border-t border-[var(--color-rule)]" data-reveal>
  <div class="relative flex flex-col gap-3 py-7 sm:flex-row sm:gap-10">
    <div
      class="mono shrink-0 text-[13px] uppercase tracking-[0.14em] text-[var(--color-ink-faint)] sm:w-36"
    >
      {period}
    </div>

    <div class="flex-1">
      <div class="flex flex-wrap items-baseline gap-x-3">
        <h3 class="display text-[clamp(1.4rem,1.5vw+0.8rem,1.85rem)] leading-tight transition-colors">
          <a href={href} class="work-card__link">{title}</a>
        </h3>
        <span class="mono text-[13px] uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
          &middot; {role}
        </span>
      </div>

      <p class="mt-2 text-[16px] leading-snug text-[var(--color-ink-soft)]">
        {summary}
      </p>

      {
        stack.length > 0 && (
          <ul class="mono mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[12px] uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">
            {stack.map((s) => (
              <li>&middot; {s}</li>
            ))}
          </ul>
        )
      }
    </div>

    <span
      class="mono hidden shrink-0 self-start text-[13px] uppercase tracking-[0.14em] text-[var(--color-ink-faint)] sm:block"
      aria-hidden="true"
    >
      <span class="work-card__arrow inline-block">{t('cta.caseStudy')}</span>
    </span>
  </div>
</article>

<style>
  .work-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-card:hover h3,
  .work-card:focus-within h3 {
    color: var(--color-accent);
  }

  .work-card__arrow {
    transition:
      translate var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-within .work-card__arrow {
    color: var(--color-accent);
    translate: 4px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .work-card__arrow { translate: none; }
  }
</style>
