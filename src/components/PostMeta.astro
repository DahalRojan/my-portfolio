---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  date: Date;
  updated?: Date;
  minutes?: number;
}

const { date, updated, minutes } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fmt = (d: Date) =>
  d.toLocaleDateString(lang === 'ne' ? 'ne-NP' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<div>
  <div
    class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[13px] uppercase tracking-[0.14em] text-[var(--color-ink-soft)]"
  >
    <time datetime={date.toISOString()} class="tabnums">{fmt(date)}</time>
    {
      updated && (
        <time datetime={updated.toISOString()} class="tabnums text-[var(--color-ink-faint)]">
          &middot; {t('meta.updated')} {fmt(updated)}
        </time>
      )
    }
    {
      minutes != null && (
        <span class="tabnums text-[var(--color-ink-faint)]">
          &middot; {minutes} {t('meta.minRead')}
        </span>
      )
    }
  </div>

</div>
