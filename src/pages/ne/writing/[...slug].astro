---
import Post from '../../../layouts/Post.astro';
import { getCollection, render } from 'astro:content';
import { minutesOf } from '../../../lib/reading';
import { entrySlug, filterByLang } from '../../../lib/content';
import { relatedPosts } from '../../../lib/taxonomy';

export async function getStaticPaths() {
  const posts = filterByLang(
    await getCollection('writing', ({ data }) => !data.draft),
    'ne'
  ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return posts.map((post, i) => ({
    params: { slug: entrySlug(post) },
    props: { post, all: posts, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, all, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = minutesOf(post.body ?? '');
const related = relatedPosts(post, all);

const link = (p?: (typeof all)[number]) =>
  p ? { href: `/ne/writing/${entrySlug(p)}`, title: p.data.title } : undefined;
---

<Post
  title={post.data.title}
  dek={post.data.dek}
  date={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  minutes={minutes}
  headings={headings}
  ogImage={`/og/writing-${entrySlug(post)}.png`}
  prev={link(newer)}
  next={link(older)}
  related={related}
>
  <Content />
</Post>
