---
import CaseStudy from '../../../layouts/CaseStudy.astro';
import { getCollection, render } from 'astro:content';
import { entrySlug, filterByLang } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = filterByLang(
    await getCollection('work', ({ data }) => !data.draft),
    'ne'
  );
  return projects.map((project) => ({
    params: { slug: entrySlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<CaseStudy
  title={project.data.title}
  summary={project.data.summary}
  role={project.data.role}
  period={project.data.period}
  stack={project.data.stack}
  headings={headings}
  ogImage={`/og/work-${entrySlug(project)}.png`}
>
  <Content />
</CaseStudy>
