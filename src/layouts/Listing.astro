---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  intro?: string;
}

const { title, description, kicker, intro } = Astro.props;
---

<Base title={title} description={description}>
  <section class="hero-wash container-x py-14 sm:py-20">
    <header class="measure-wide">
      {kicker && <p class="kicker" data-enter style="--enter-index: 0">{kicker}</p>}
      <h1
        class="display mt-4 text-[clamp(2.2rem,4vw+1rem,3.6rem)]"
        data-enter
        style="--enter-index: 1"
      >
        {title}
      </h1>
      {
        intro && (
          <p class="dek measure mt-5" data-enter style="--enter-index: 2">
            {intro}
          </p>
        )
      }
      <slot name="header-extra" />
    </header>

    <div class="mt-14">
      <slot />
    </div>
  </section>
</Base>
